# fabMem enterprise — configuration. Copy to `.env` and fill in.
# Every value is read from the environment at boot; nothing is baked into the image and nothing is read from a
# file inside the container. Missing required values fail the container at startup rather than degrading.

# ─────────────────────────────────────────────────────────────────────────────
# 1. IMAGE
# ─────────────────────────────────────────────────────────────────────────────
# Pinned tag — never `latest`. Upgrades are deliberate; see CHANGELOG.md.
FABMEM_IMAGE=ghcr.io/ainakwalamonk/fabmem-enterprise:1.0.0

# Port published on the host. Terminate TLS in front of this (ALB / nginx / Caddy).
FABMEM_HOST_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# 2. DATABASE
# ─────────────────────────────────────────────────────────────────────────────
# LEAVE DATABASE_URL UNSET. The container hosts its own PostgreSQL 17 with `vector` and `pg_textsearch`
# already provisioned, storing data on the volume in section 4. Nothing to install, no password to set.
#
# Set it ONLY to point at an external server, which must carry BOTH extensions. `pg_textsearch` needs
# shared_preload_libraries and is on no managed provider's allowlist (checked 2026-09 against Azure Flexible
# Server, RDS and Aurora), so a managed instance still starts and still answers, but every keyword/BM25 lane
# returns nothing — the migration logs `pg_textsearch not available - BM25 indexes not created` and continues.
# DATABASE_URL=postgres://user:password@host:5432/fabmem?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# 3. SERVICE TOKENS  (openssl rand -hex 32)
# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap credential for CI's POST /ingest/build. Once the dashboard is reachable, issue per-CI API keys there
# instead: they are revocable individually, record last-used, and are stored as salted scrypt hashes.
FABMEM_INGEST_TOKEN=

# Fallback for /mcp and the dashboard, used ONLY while WORKOS_ISSUER is unset below.
FABMEM_QUERY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 4. STORAGE
# ─────────────────────────────────────────────────────────────────────────────
# ONE volume holds everything that must survive: the database (.fabmem/pgdata), extracted source snapshots, the
# indexer cache and the embedding model. Unset = a Docker-managed named volume. Set an ABSOLUTE PATH to
# bind-mount your own disk; it must be writable by uid 10001, the non-root user the image runs as (Postgres
# refuses to run as root).
# FABMEM_DATA_PATH=/mnt/fabmem-data

# ─────────────────────────────────────────────────────────────────────────────
# 5. SSO  (optional — omit for token-only access)
# ─────────────────────────────────────────────────────────────────────────────
# Setting WORKOS_ISSUER switches /mcp AND the dashboard to WorkOS AuthKit, and enables OAuth discovery at
# /.well-known/oauth-protected-resource so MCP clients find the login flow themselves.
# WORKOS_ISSUER=https://your-tenant.authkit.app

# Required when SSO is on: the dashboard's first-party sign-in needs a real client id (AuthKit answers
# "Invalid client ID" without it). /mcp does NOT check it as an audience — a remote MCP client registers its own
# client via DCR, so its token's `aud` is that client, never this one.
# WORKOS_CLIENT_ID=

# Required for the dashboard only: AuthKit's code exchange is a confidential-client call whose response carries
# no CORS headers, so the browser cannot perform it and the server does.
# WORKOS_API_KEY=

# Restrict who may sign in. Comma-separated. EMPTY MEANS ANY authenticated user of that tenant — set at least one
# of these before exposing the deployment.
# WORKOS_ALLOWED_DOMAINS=yourcompany.com
# WORKOS_ALLOWED_ORG_ID=

# The PUBLIC https URL of this service. Required behind a load balancer or reverse proxy: OAuth discovery
# advertises this to clients, and deriving it from `Host` gets it wrong when the proxy rewrites the header.
# FABMEM_MCP_RESOURCE_URL=https://fabmem.yourcompany.com

# ─────────────────────────────────────────────────────────────────────────────
# 6. LLM ENRICHMENT  (optional — everything below is OFF by default)
# ─────────────────────────────────────────────────────────────────────────────
# NOT required to run. Indexing, embeddings and every search lane work with no LLM at all: embeddings come from
# a local model baked into the image, and no query path calls an LLM (search_everything returns raw hits, never
# a synthesized answer). A deployment with none of this set is fully functional.
#
# What these buy: the `code:summarize` worker, a doc2query pass that writes per-symbol query text and raises
# search-hit quality. It self-gates — it waits until embeddings have caught up, so search works first, and it
# stops when the budget is spent.
#
# COSTS MONEY, on YOUR account. The keys are yours; fabMem never proxies LLM calls.
# FABMEM_SUMMARIZE=1

# Azure OpenAI, `classification` tier (the summarizer's tier). Use a small, cheap deployment.
# AZURE_OPENAI_CLASSIFICATION_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_CLASSIFICATION_KEY=
# AZURE_OPENAI_CLASSIFICATION_DEPLOYMENT=<your deployment name>
# AZURE_OPENAI_CLASSIFICATION_API_VERSION=2024-12-01-preview
