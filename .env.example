# fabMem enterprise — configuration. Copy to `.env` and fill in.
# Every value is read from the environment at boot; nothing is baked into the image and nothing is read from a
# file inside the container. Missing required values fail the container at startup rather than degrading.

# ─────────────────────────────────────────────────────────────────────────────
# 1. IMAGE
# ─────────────────────────────────────────────────────────────────────────────
# Pinned tag — never `latest`. Upgrades are deliberate; see CHANGELOG.md.
FABMEM_IMAGE=ghcr.io/ainakwalamonk/fabmem-enterprise:1.0.0

# Port published on the host. Terminate TLS in front of this (ALB / nginx / Caddy).
FABMEM_HOST_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# 2. DATABASE
# ─────────────────────────────────────────────────────────────────────────────
# TWO extensions are required:
#   vector         (pgvector)     — semantic search
#   pg_textsearch  (BM25 ranking) — keyword search
#
# pg_textsearch is NOT available on managed Postgres (checked 2026-09: absent from Azure
# Flexible Server's extension list and from RDS/Aurora; it needs shared_preload_libraries,
# which pg_tle cannot provide). Only Tiger Cloud offers it managed.
#
# So the SUPPORTED configuration is the bundled database below, which ships both extensions:
#
#     docker compose --profile bundled-db up -d
#
# DATABASE_URL is then derived from the password here and can be left unset.
FABMEM_DB_PASSWORD=

# The bundled Postgres image. Must carry BOTH pgvector and pg_textsearch.
FABMEM_DB_IMAGE=ghcr.io/ainakwalamonk/fabmem-postgres:17

# (Alternative, DEGRADED) Your own Postgres. Works if the server has both extensions —
# i.e. self-managed, where you can install the module and set shared_preload_libraries.
# Against MANAGED Postgres the app still starts and semantic search works, but every
# keyword/BM25 lane returns nothing: the migration logs
# `WARNING: pg_textsearch not available - BM25 indexes not created` and carries on.
# The role needs CREATE on the database; migrations run automatically at boot.
# DATABASE_URL=postgres://user:password@host:5432/fabmem?sslmode=require

# Password for the non-superuser `fabric_app` role the app provisions for row-level tenancy.
FABRIC_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 3. SERVICE TOKENS  (openssl rand -hex 32)
# ─────────────────────────────────────────────────────────────────────────────
# CI uses this to POST /ingest/build. Machine lane — always a static token.
FABMEM_INGEST_TOKEN=

# Fallback token for /mcp, used ONLY when WorkOS is not configured below.
FABMEM_QUERY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 4. SSO for /mcp  (optional — omit for token-only access)
# ─────────────────────────────────────────────────────────────────────────────
# Setting WORKOS_ISSUER switches /mcp from the static token to WorkOS AuthKit OIDC and
# enables OAuth discovery at /.well-known/oauth-protected-resource. Developers then sign in
# with Google in their MCP client; no per-user tokens to distribute.
# WORKOS_ISSUER=https://your-tenant.authkit.app

# Expected `aud`. Recommended in production — without it any token from the issuer validates.
# WORKOS_CLIENT_ID=

# Restrict to your email domain(s) and/or one WorkOS org. Comma-separated. Empty = any
# authenticated user of that tenant.
# WORKOS_ALLOWED_DOMAINS=yourcompany.com
# WORKOS_ALLOWED_ORG_ID=

# The PUBLIC https URL of this service. Required behind a load balancer or reverse proxy:
# OAuth discovery advertises this to clients, and deriving it from `Host` gets it wrong when
# the proxy rewrites the header.
# FABMEM_MCP_RESOURCE_URL=https://fabmem.yourcompany.com

# ─────────────────────────────────────────────────────────────────────────────
# 5. INDEXING
# ─────────────────────────────────────────────────────────────────────────────
# Where extracted source snapshots live inside the container.
DATA_DIR=/data

# ─────────────────────────────────────────────────────────────────────────────
# 6. STORAGE
# ─────────────────────────────────────────────────────────────────────────────
# Unset = Docker-managed named volumes on the host's docker disk. Both then share one
# disk and compete for space, which is fine for an evaluation.
#
# Set either to an ABSOLUTE PATH to bind-mount your own disk — recommended in production,
# since the two grow at very different rates and only the database is expensive to lose.
# The host directory must exist and be writable by the container's user (Postgres runs
# as uid 999); Docker does not pre-seed permissions on a bind mount.
#
# FABMEM_DB_PATH=/mnt/fabmem-db      # Postgres — BACK THIS UP
# FABMEM_DATA_PATH=/mnt/fabmem-data  # extracted source — rebuildable by re-sending builds
